{
  "name": "extra-clarity",
  "version": "21.0.0",
  "scripts": {
    "ng": "ng",
    "start": "ng serve",
    "build": "ng build",
    "build:extra-clarity": "ng build extra-clarity",
    "watch": "ng build --watch --configuration development",
    "lint": "ng lint",
    "lint:fix": "ng lint --fix",
    "test": "vitest run",
    "build:storybook": "ng run extra-clarity:build-storybook",
    "serve:storybook": "ng run extra-clarity:storybook --no-open",
    "docs:extra-clarity": "npx compodoc -e json -d . -p tsconfig.doc.json --minimal --disableLifeCycleHooks --disablePrivate --disableProtected",
    "release": "release-it",
    "release-notes": "npx conventional-changelog-cli -k ./projects/extra-clarity/package.json -r 2 --skip-unstable -t v -p conventionalcommits -n ./.release-notes.github.json",
    "prettier": "npx prettier --write .",
    "prepare": "husky || true"
  },
  "lint-staged": {
    "*.{html,ts,js,mjs,mdx}": [
      "prettier --write",
      "eslint --fix"
    ],
    "*.{json,css,scss}": [
      "prettier --write"
    ]
  },
  "private": true,
  "dependencies": {
    "@angular/animations": "22.1.4",
    "@angular/cdk": "22.1.4",
    "@angular/common": "22.1.4",
    "@angular/compiler": "22.1.4",
    "@angular/core": "22.1.4",
    "@angular/forms": "22.1.4",
    "@angular/platform-browser": "22.1.4",
    "@angular/platform-browser-dynamic": "22.1.4",
    "@angular/router": "22.1.4",
    "@clr/angular": "18.2.2",
    "@clr/ui": "18.2.2",
    "rxjs": "7.8.2",
    "tslib": "2.8.1",
    "zone.js": "0.16.2"
  },
  "devDependencies": {
    "@analogjs/vite-plugin-angular": "2.7.1",
    "@angular/build": "22.1.6",
    "@angular/cli": "22.1.6",
    "@angular/compiler-cli": "22.1.4",
    "@commitlint/cli": "19.8.0",
    "@commitlint/config-conventional": "19.8.0",
    "@compodoc/compodoc": "1.1.26",
    "@release-it/bumper": "7.0.2",
    "@release-it/conventional-changelog": "10.0.0",
    "@storybook/addon-docs": "10.5.10",
    "@storybook/addon-links": "10.5.10",
    "@storybook/angular-vite": "10.5.10",
    "@types/mdx": "2.0.13",
    "angular-eslint": "22.1.0",
    "conventional-changelog-cli": "5.0.0",
    "conventional-changelog-conventionalcommits": "8.0.0",
    "eslint": "9.23.0",
    "eslint-config-prettier": "10.1.1",
    "eslint-import-resolver-typescript": "4.2.3",
    "eslint-plugin-import": "2.31.0",
    "eslint-plugin-storybook": "10.5.10",
    "globals": "16.0.0",
    "husky": "9.1.7",
    "lint-staged": "15.5.0",
    "ng-packagr": "22.1.1",
    "prettier": "3.5.3",
    "release-it": "18.1.2",
    "storybook": "10.5.10",
    "typescript": "6.0.3",
    "typescript-eslint": "8.68.0",
    "vite": "8.2.2",
    "vitest": "4.1.11"
  },
  "engines": {
    "node": "^22.22.3 || ^24.15.0 || >=26.0.0"
  }
}
